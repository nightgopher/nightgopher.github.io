---
import Base from '../layouts/Base.astro';
import portfolio from '../../data/portfolio.json';
import status from '../../data/status.json';

// 旧版手写站的全部内容在构建期静态渲染；数据由 sync workflow 自动更新并触发重部署。
const statusLabels: Record<string, string> = {
  'release-candidate': '候选已验证',
  integrated: '已接入',
  verified: '已验证',
  active: '进行中',
  planned: '计划中',
};
const kindLabels: Record<string, string> = {
  tool: '工具作品',
  learning: '教学实践',
  fork: '上游改造',
  other: '其他探索',
};
const prLabels: Record<string, string> = { merged: '已合并', open: '待合并', closed: '已关闭' };

const initiative = status.initiative;
const { passed, total } = initiative.acceptance;
const percent = total > 0 ? Math.max(0, Math.min(100, Math.round((passed / total) * 100))) : 0;
const phase = statusLabels[initiative.status] ?? initiative.status;

const infraProjects = status.projects.filter((p) => p.category !== 'portfolio');
const publicProjects = status.projects.filter((p) => p.visibility === 'public');

const featured = portfolio.featured
  .map((id) => {
    const project = publicProjects.find((p) => p.id === id);
    const info = portfolio.projects[id];
    return project && info ? { project, info } : null;
  })
  .filter((row): row is NonNullable<typeof row> => row !== null);
---

<Base
  title="Hwj · 项目与实践"
  description="Hwj 的项目与实践：个人 Agent 基础设施（easyagent + EasyGateway）、AI 编程协作与 Java 转 Go 交互教学。查看代表作、个人贡献和公开验证状态。"
>
  <a class="skip-link" href="#content">跳到正文</a>
  <header class="site-header">
    <a class="brand" href="#top" aria-label="返回顶部">
      <span class="brand-mark" aria-hidden="true">H</span>
      <span>Hwj · 项目与实践</span>
    </a>
    <nav aria-label="主导航">
      <a href="#featured">代表作</a>
      <a href="#projects">项目</a>
      <a href="#portfolio">全部作品</a>
      <a href="/skills/">技能广场</a>
      <a href="/easy-suite/">产品官网</a>
      <a href="https://github.com/nightgopher" target="_blank" rel="noopener">GitHub ↗</a>
    </nav>
  </header>

  <main id="content">
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="eyebrow"><span class="live-dot" aria-hidden="true"></span> Building in public</p>
        <h1>把开发中的问题，<br /><em>做成可复用的工具。</em></h1>
        <p class="hero-lead">
          我是 Hwj，围绕 AI 编程协作、个人 Agent 基础设施和后端学习持续实践。这里记录做出的工具、对上游的改造，以及能跟着练的教学项目。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#featured">先看代表作</a>
          <a class="button button-secondary" href="#portfolio">浏览项目目录 ↓</a>
        </div>
      </div>

      <aside class="release-card" aria-labelledby="release-title">
        <div class="release-card-head">
          <div>
            <p class="card-kicker">Active initiative</p>
            <h2 id="release-title">{initiative.title}</h2>
          </div>
          <span class="status-pill">{phase}</span>
        </div>
        <p>{initiative.summary}</p>
        <div class="progress-copy">
          <span>验收进度</span>
          <strong>{passed} / {total}</strong>
        </div>
        <div class="progress-track" aria-hidden="true">
          <span style={`width: ${percent}%`}></span>
        </div>
        <p class="verified-date">功能验证 <time datetime={initiative.last_verified}>{initiative.last_verified}</time></p>
      </aside>
    </section>

    <section class="section" id="featured" aria-labelledby="featured-title">
      <div class="section-heading">
        <h2 id="featured-title">从三个项目认识我</h2>
        <p>先看解决的问题，再看实现与取舍。每个入口都能继续追到源码。</p>
      </div>
      <div class="featured-list">
        {
          featured.map(({ project, info }) => (
            <article class="featured-project">
              <div class="featured-title">
                <span class="feature-label">{info.label}</span>
                <h3>{project.name}</h3>
              </div>
              <div class="featured-body">
                <p class="feature-problem">{info.problem}</p>
                <p>{info.contribution}</p>
                <a class="feature-link" href={info.proof_url} target="_blank" rel="noopener">
                  {info.proof} ↗
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="architecture section" id="architecture" aria-labelledby="architecture-title">
      <div class="section-heading split-heading">
        <div>
          <h2 id="architecture-title">从入口到经验，一条链路</h2>
        </div>
        <p>每一层只承担清晰职责，并用可验证的契约连接。网关保留审计线索，经验库负责踩坑沉淀与统一检索。</p>
      </div>
      <ol class="pipeline" aria-label="个人 Agent 基础设施链路">
        <li><span>01</span><strong>多端入口</strong><small>CLI · 桌面 · 移动端</small></li>
        <li><span>02</span><strong>Agent 运行时</strong><small>会话 · 工具 · 技能</small></li>
        <li><span>03</span><strong>统一网关</strong><small>路由 · fallback · 归档</small></li>
        <li><span>04</span><strong>运行值守</strong><small>自动更新 · 健康检查 · 回滚</small></li>
        <li><span>05</span><strong>经验沉淀</strong><small>踩坑复盘 · 统一检索</small></li>
      </ol>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="section-heading">
        <h2 id="projects-title">三个组件，一条主线</h2>
        <p>公开仓库可直接查看源码；内部组件只展示它们在系统中的职责。</p>
      </div>
      <div class="project-grid">
        {
          infraProjects.map((project) => (
            <article class="project-card">
              <h3>
                {project.repository_url ? (
                  <a href={project.repository_url} target="_blank" rel="noopener">
                    {project.name}
                  </a>
                ) : (
                  project.name
                )}
              </h3>
              <p>{project.role}</p>
              <div class="project-meta">
                <span>{statusLabels[project.status] ?? project.status}</span>
                {project.language && <span>{project.language}</span>}
                {project.visibility === 'private' && <span>内部组件</span>}
                {project.last_pushed_at && <span class="meta-date">代码更新 {project.last_pushed_at}</span>}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" id="portfolio" aria-labelledby="portfolio-title">
      <div class="section-heading">
        <h2 id="portfolio-title">项目目录</h2>
        <p>按用途浏览；“上游改造”会注明继承能力和个人改动。探索项目保留独立入口。</p>
      </div>
      <div class="catalog-tools">
        <div class="filters" role="group" aria-label="按项目类型筛选">
          <button type="button" data-filter="all" aria-pressed="true">全部</button>
          <button type="button" data-filter="tool" aria-pressed="false">工具作品</button>
          <button type="button" data-filter="learning" aria-pressed="false">教学实践</button>
          <button type="button" data-filter="fork" aria-pressed="false">上游改造</button>
          <button type="button" data-filter="other" aria-pressed="false">其他探索</button>
        </div>
        <label class="search-label">搜索项目 <input id="project-search" type="search" placeholder="名称或关键词" /></label>
      </div>
      <p id="catalog-count" class="catalog-count" role="status"></p>
      <div class="project-grid catalog" id="portfolio-grid" aria-live="polite">
        {
          publicProjects.map((project) => {
            const info = portfolio.projects[project.id] ?? {};
            const kind = info.kind ?? 'other';
            return (
              <article
                class="project-card catalog-card"
                data-kind={kind}
                data-search={`${project.name} ${project.role} ${info.contribution ?? ''} ${kindLabels[kind]}`.toLocaleLowerCase()}
              >
                <h3>
                  {project.repository_url ? (
                    <a href={project.repository_url} target="_blank" rel="noopener">
                      {project.name}
                    </a>
                  ) : (
                    project.name
                  )}
                </h3>
                <p>{info.contribution ?? project.role}</p>
                <div class="project-meta">
                  <span class="meta-badge">{kindLabels[kind]}</span>
                  <span>{statusLabels[project.status] ?? project.status}</span>
                  {project.language && <span>{project.language}</span>}
                  {project.last_pushed_at && <span class="meta-date">代码更新 {project.last_pushed_at}</span>}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <section class="section initiative" id="initiative" aria-labelledby="initiative-title">
      <div class="initiative-copy">
        <h2 id="initiative-title">持续追踪实际进展</h2>
        <p>
          easyagent 与 EasyGateway 已在日常使用中值守运行。完成不以文档勾选为准，而以合并、部署与生产环境复测为准。
        </p>
        <dl class="metrics">
          <div><dt>核心组件</dt><dd>{infraProjects.length}</dd></div>
          <div><dt>验收通过</dt><dd>{total > 0 ? `${percent}%` : '待验证'}</dd></div>
          <div><dt>阶段</dt><dd>{phase}</dd></div>
        </dl>
      </div>
      <div class="release-gates">
        <h3>公开发布门禁</h3>
        <ul class="pr-list">
          {
            (initiative.public_pull_requests ?? []).map((pr) => (
              <li>
                <a href={pr.url} target="_blank" rel="noopener">
                  {pr.repository} · PR #{pr.number}
                  <span class={`pr-state ${pr.state ?? 'unknown'}`}>{prLabels[pr.state] ?? '状态待确认'}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="gate-note">私有项目门禁与详细证据保留在控制仓库，本页面遵循最小披露原则。</p>
      </div>
    </section>
  </main>

  <footer>
    <p>Hwj AI Infrastructure <span aria-hidden="true">·</span> Evidence before status.</p>
    <p>仓库信息同步于 <time datetime={status.generated_at}>{status.generated_at}</time></p>
  </footer>

  <script>
    // 项目目录筛选与搜索：卡片为构建期静态渲染，这里只做显隐过滤。
    const grid = document.getElementById('portfolio-grid');
    const count = document.getElementById('catalog-count');
    const search = document.getElementById('project-search') as HTMLInputElement;
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(grid?.querySelectorAll<HTMLElement>('.catalog-card') ?? []);
    const totalLabel = `${cards.length}`;

    let filter = 'all';
    const renderCatalog = () => {
      const query = (search?.value ?? '').trim().toLocaleLowerCase();
      let visible = 0;
      for (const card of cards) {
        const kind = card.dataset.kind ?? 'other';
        const hay = card.dataset.search ?? '';
        const show = (filter === 'all' || kind === filter) && hay.includes(query);
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (count) count.textContent = `显示 ${visible} / ${totalLabel} 个公开项目`;
    };
    for (const button of buttons) {
      button.addEventListener('click', () => {
        filter = button.dataset.filter ?? 'all';
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        renderCatalog();
      });
    }
    search?.addEventListener('input', renderCatalog);
    renderCatalog();
  </script>
</Base>
